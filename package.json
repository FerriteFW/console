{
  "name": "ferrite-console",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "Ferrite Console: live view, remote keys and (next) channel programming for Ferrite on the Radtel RT-950 Pro",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "test": "cargo test -p ferrite-console-core && node --test tests/unit/",
    "e2e": "npm run wasm && VITE_DEV_TOOLS=1 vite build && playwright test",
    "e2e:run": "playwright test",
    "e2e:xeon": "tools/e2e-xeon.sh",
    "tauri": "tauri",
    "bundle-firmware": "node scripts/bundle-firmware.mjs",
    "build:dev": "npm run wasm && VITE_DEV_TOOLS=1 vite build",
    "build:single": "npm run wasm && vite build --mode single"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "svelte": "^5.57.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "leaflet": "^1.9.4"
  }
}
