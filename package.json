{
  "name": "ferrite-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ferrite Console: live view, remote keys and (next) channel programming for Ferrite on the Radtel RT-950 Pro",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "test": "cargo test -p ferrite-console-core",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "svelte": "^5.57.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
