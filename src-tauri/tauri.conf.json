{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferrite Console",
  "version": "0.9.2",
  "identifier": "dev.ferritefw.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ferrite Console",
        "width": 1280,
        "height": 800,
        "center": true,
        "minWidth": 720,
        "minHeight": 600,
        "backgroundColor": "#0B0D10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "macOS": { "entitlements": "Entitlements.plist" },
    "shortDescription": "Live view and remote keys for Ferrite radios",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["ferrite"],
        "name": "Ferrite codeplug",
        "description": "Ferrite codeplug",
        "role": "Editor",
        "mimeType": "application/x-ferrite-codeplug",
        "exportedType": { "identifier": "dev.ferritefw.console.codeplug", "conformsTo": ["public.data", "public.zip-archive"] }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5MjI4QkJBNkU3NkVFRkMKUldUODduWnV1b3NpcVZsUldmSXp6N24ydWhiSXI2cFFibnZWM2oyVitzZ3YxOEZVN1JmR1EwOXUK",
      "endpoints": ["https://github.com/FerriteFW/console/releases/latest/download/latest.json"]
    }
  }
}
