# Copy to .env (git-ignored); just loads it for every recipe. All optional.

# Another machine for the heavy recipes: just remote test, just remote e2e (user@host:path, the parent folder:
# the checkout goes to path/console, ../ferrite beside it). Its host also builds Linux and Windows (just desktop all).
FERRITE_REMOTE=

# The firmware just desktop and just bundle-firmware put in the app: "RELEASE.ffw READER.btf RESTORER.btf"
# (.minisig files beside). Unset: ../ferrite/target's build, else the release just setup downloaded to target/firmware/.
# FIRMWARE=

# just desktop mac without the team's Developer ID (an ad-hoc signature, fine on the Mac that built it)
# UNSIGNED=1
